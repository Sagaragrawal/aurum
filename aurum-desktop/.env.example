# ---- server ----
PORT=8787
HOST=0.0.0.0

# ---- scraping cadence (minutes) ----
BULLION_INTERVAL_MIN=30
PRODUCT_INTERVAL_MIN=5
PRODUCT_CONCURRENCY=5

# How many product pages to fetch in parallel. Keep low = polite = less likely to be blocked.
CONCURRENCY=2

# Random delay range (ms) inserted between requests to the same host.
MIN_DELAY_MS=1500
MAX_DELAY_MS=4500

# ---- anti-bot tiers ----
# 1 = allow escalating to a real headless Chromium when plain HTTP is blocked (403/429/JS-wall).
# 0 = HTTP only (lowest RAM, cheapest hosting).
FETCH_BROWSER=1

# Reuse one browser context on disk so cookies/clearance tokens persist between runs.
BROWSER_PROFILE_DIR=./data/browser-profile

# Optional outbound proxy for the HTTP tier, e.g. http://user:pass@host:port
# HTTP_PROXY=

# Optional: comma separated tokens required in X-Api-Key header for write endpoints.
# Leave empty to disable auth (fine for localhost).
API_KEY=

# Set to 1 on a proxy-authenticated desktop when a browser credential prompt needs manual entry.
PROXY_INTERACTIVE=0
PROXY_INTERACTIVE_WAIT_MS=60000

# Flipkart delivery search used by the browser collector.
FLIPKART_LOCATION=Dhruvika Mogra Apartment

# Product refresh tuning (rendered Firefox pages; MacBook-balanced defaults)
# Firefox remains alive, but only one blank idle page is retained per store context.
PRODUCT_CONCURRENCY=6
PRODUCT_AJIO_CONCURRENCY=6
PRODUCT_AMAZON_CONCURRENCY=4
PRODUCT_FLIPKART_CONCURRENCY=6
PRODUCT_MYNTRA_CONCURRENCY=6
PRODUCT_BLOCK_HEAVY_ASSETS=1
PRODUCT_POOL_IDLE_PAGES=1
PRODUCT_POOL_BLANK_IDLE=1
# Maximum store refresh jobs running at the same time. 2 keeps peak RAM/CPU much lower.
PRODUCT_STORE_PARALLELISM=2

# ---- optional speculative HTTP fast path ----
# Tries ordinary HTML very briefly before opening a rendered browser page.
# Any miss/block/timeout automatically falls back to Playwright. Set 0 to disable.
PRODUCT_HTTP_FAST_PATH=1
PRODUCT_HTTP_FAST_TIMEOUT_MS=1800
PRODUCT_HTTP_FAST_CONCURRENCY=24
PRODUCT_HTTP_FAST_PROBE_COUNT=8
PRODUCT_HTTP_FAST_COOLDOWN_MS=300000
